# Supabase — credenziali per lo scraper (NON committare mai questo file)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# (in alternativa, solo per sviluppo read-only:)
# SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# Frontend (Vite) — copia/completa e rinomina in `.env`
# Necessarie per uscire dalla modalità demo e attivare checkout,
# auth reale e cancellazione account.
# ============================================================
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<ANON_KEY>

# Stripe — Price IDs esposti al frontend (SOLO verifica/debug: la fonte
# autorevole dei prezzi è server-side nei secrets Supabase STRIPE_PRICE_*).
# Se vuoti, il checkout usa comunque i secrets.
VITE_STRIPE_PRICE_PRO_ANNUALE=
VITE_STRIPE_PRICE_PRO_MENSILE=
VITE_STRIPE_PRICE_ALACARTE=

# Stripe — modalità server-side (test | live). Il checkout auto-rileva 'live'
# se STRIPE_SECRET_KEY inizia con sk_live_. Secrets canonici (supabase secrets set):
#   STRIPE_PRICE_ID_ANNUAL   = price_1U8GvSKHxfBbZQd8tFCGKT6k   (PRO annuale 49€)
#   STRIPE_PRICE_ID_MONTHLY  = price_1U8GwMKHxfBbZQd8bHFbT0Zq   (PRO mensile 9€)
#   STRIPE_PRICE_ID_CONSUMO  = price_1U8H14KHxfBbZQd834eSWOuE   (a consumo 5€)
#   REFERRAL_COUPON_ID       = TOQf7ze2                          (coupon -10€ sul PRO annuale)
#   WEBHOOK_ENDPOINT         = https://gwdmsgsshvdnfrplbjiv.supabase.co/functions/v1/webhook
#   STRIPE_WEBHOOK_SECRET    = whsec_… (signing secret test o live, dal dashboard Stripe → Webhooks)
#   STRIPE_PUBLISHABLE_KEY   = pk_live_... (publishable key - pubblica, esposta al frontend)
#   STRIPE_SECRET_KEY        = sk_live_... (chiave segreta - SOLO nei secrets, MAI nel browser)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_<PUBLISHABLE_KEY>
STRIPE_PUBLISHABLE_KEY=pk_live_<PUBLISHABLE_KEY>
STRIPE_SECRET_KEY=sk_live_<SECRET_KEY>
STRIPE_WEBHOOK_SECRET=whsec_<WEBHOOK_SECRET>
STRIPE_MODE=live

# Google One Tap — client ID del provider Google configurato in Supabase Auth.
# Se mancante, il codice usa di default 1048863944948-cucj8ei0a73o20vtq1vg29gscpchkr80.apps.googleusercontent.com
# (la client ID è pubblica: serve solo a initialize() di GSI e allo scambio ID token → sessione Supabase).
VITE_GOOGLE_CLIENT_ID=1048863944948-cucj8ei0a73o20vtq1vg29gscpchkr80.apps.googleusercontent.com


# Scraper — province di test (le fonti reali per provincia sono definite nello script)
# FONTE_TEST_URL=  (opzionale: override della fonte della prima provincia)
FONTE_TEST_URL=
SCRAPER_PROVINCE_TEST=MI,TO

# Frontend (PASSO 3) — chiave ANON pubblica, mai la service_role nel browser
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Resend — notifiche email (FASE 4)
# Usa la tua API key reale SOLO nel file .env locale (git-ignored), MAI in .env.example
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Mittente di default (dominio verificato su Resend; default: onboarding@resend.dev)
RESEND_FROM_EMAIL=ScuoleRadar <onboarding@resend.dev>
# URL della dashboard per il pulsante CTA nelle email
# RESEND_DASHBOARD_URL=https://scuoleradar.it/dashboard/radar

# Telegram — bot notifiche (FASE 5)
# Token del bot @ScuoleRadar_bot (usa il token reale SOLO nel .env locale)
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenPlaceholder

# ============================================================
# DeepSeek — generazione modulistica (Edge Function `genera-modulo`)
# Chiave API per la generazione dinamica dei documenti scolastici.
# Configurazione SERVER-SIDE nei secrets Supabase (MAI nel browser):
#   supabase secrets set DEEPSEEK_API_KEY=sk-... --project-ref gwdmsgsshvdnfrplbjiv
#   supabase secrets set DEEPSEEK_MODEL=deepseek-chat --project-ref gwdmsgsshvdnfrplbjiv
#   supabase functions deploy genera-modulo --project-ref gwdmsgsshvdnfrplbjiv
# ============================================================
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# Analytics leggero e privacy-first (PostHog)
# Attivo SOLO se VITE_POSTHOG_KEY e valorizzato (vuoto = disattivato, nessun invio).
# Host predefinito: https://eu.i.posthog.com (progetto EU) - cambiare per US.
# VITE_POSTHOG_KEY=<project-api-key>
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# ============================================================
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ============================================================
# Account Bridge  ScuoleRadar PRO <-> PureFocus PRO
# VITE_PUREFOCUS_BRIDGE_SECRET: segreto HMAC condiviso per firmare il token
#   bridge (stesso valore sul backend PureFocus; vuoto = bridge disattivato).
# VITE_PUREFOCUS_BRIDGE_URL: endpoint di destinazione (default PureFocus).
# ============================================================
VITE_PUREFOCUS_BRIDGE_SECRET=
VITE_PUREFOCUS_BRIDGE_URL=https://purefocus.app/auth/bridge
