# Supabase — credenziali per lo scraper (NON committare mai questo file)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# (in alternativa, solo per sviluppo read-only:)
# SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# Frontend (Vite) — copia/completa e rinomina in `.env`
# Necessarie per uscire dalla modalità demo e attivare checkout,
# auth reale e cancellazione account.
# ============================================================
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<ANON_KEY>

# Stripe — Price IDs esposti al frontend (SOLO verifica/debug: la fonte
# autorevole dei prezzi è server-side nei secrets Supabase STRIPE_PRICE_*).
# Se vuoti, il checkout usa comunque i secrets.
VITE_STRIPE_PRICE_PRO_ANNUALE=
VITE_STRIPE_PRICE_PRO_MENSILE=
VITE_STRIPE_PRICE_ALACARTE=


# Scraper — province di test (le fonti reali per provincia sono definite nello script)
# FONTE_TEST_URL=  (opzionale: override della fonte della prima provincia)
FONTE_TEST_URL=
SCRAPER_PROVINCE_TEST=MI,TO

# Frontend (PASSO 3) — chiave ANON pubblica, mai la service_role nel browser
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Resend — notifiche email (FASE 4)
# Usa la tua API key reale SOLO nel file .env locale (git-ignored), MAI in .env.example
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Mittente di default (dominio verificato su Resend; default: onboarding@resend.dev)
RESEND_FROM_EMAIL=ScuoleRadar <onboarding@resend.dev>
# URL della dashboard per il pulsante CTA nelle email
# RESEND_DASHBOARD_URL=https://scuoleradar.it/dashboard/radar

# Telegram — bot notifiche (FASE 5)
# Token del bot @ScuoleRadar_bot (usa il token reale SOLO nel .env locale)
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenPlaceholder
